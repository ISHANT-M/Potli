{
  "name": "potli",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Local dev tooling for the Potli frontend, backend, and database",
  "scripts": {
    "setup": "node scripts/setup.ts",
    "dev": "node scripts/dev.ts",
    "start": "node scripts/dev.ts",
    "db:setup": "node scripts/setup.ts --only db --with-db",
    "build": "npm --prefix frontend run build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p shared && npm --prefix frontend run typecheck && npm --prefix backend run typecheck && npm --prefix db run typecheck",
    "lint": "eslint frontend/src",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:db:down": "docker compose -f docker-compose.test.yml down -v",
    "test": "npm run test:api && npm run test:web",
    "test:api": "npm --prefix backend test",
    "test:web": "npm --prefix frontend test",
    "e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
