# copy to .env locally
VITE_API_URL=http://localhost:4000

# --- Appwrite (browser auth) ---
# The project id is public; no API key belongs in the frontend.
VITE_APPWRITE_ENDPOINT=https://appwrite.example.com/v1
VITE_APPWRITE_PROJECT_ID=

# Optional HTTPS MapLibre style for a compatible provider or self-hosted basemap.
# Defaults to the OpenFreeMap Liberty style when unset.
# VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
