# never commit real credentials; copy to .env locally
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require
JWT_SECRET=potli-dev-secret-change-me
PORT=4000
# shared dev password used by db:seed for all four accounts
DEV_SEED_PASSWORD=Potli123!

# --- Supabase (canonical: auth + Postgres) ---
# Dashboard -> Project Settings -> API
SUPABASE_URL=https://PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=
# Dashboard -> Connect -> Session pooler (the project's own region), which handles
# the DDL run by db:setup. The transaction pooler (port 6543) is the serverless
# variant, and db.<ref>.supabase.co is IPv6 only. The pre-Supabase DATABASE_URL
# above is a fallback and is ignored once this is set.
SUPABASE_DB_URL=postgresql://postgres.PROJECT-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
