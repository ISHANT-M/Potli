# Copy to .env; never commit credentials.
PORT=4000
DEV_SEED_PASSWORD=Potli123!

# Runtime mode: development | test | production. Production hides error details.
NODE_ENV=development

# Appwrite auth; the API key is server-only. The API needs it at runtime for role labels,
# disabling users and Storage; the seed uses it to create accounts. Scopes: users.read,
# users.write, buckets.read, buckets.write, files.read, files.write.
APPWRITE_ENDPOINT=https://appwrite.example.com/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=

# Private Appwrite Storage buckets; created by `npm run setup` (db/scripts/appwrite-bootstrap.ts).
APPWRITE_BUCKET_HANDOFF=handoff-photos
APPWRITE_BUCKET_LISTING=listing-photos

# Potli database in Appwrite's Postgres.
DATABASE_URL=postgresql://potli:PASSWORD@db.example.com:443/potli

# Unset for TCP; the catcher replaces the URL password with an Appwrite JWT.
DATABASE_WS_PROXY=wss://db.example.com/v1
# Separate infrastructure account with the infra label; share privately.
POTLI_DB_EMAIL=infra@example.com
POTLI_DB_PASSWORD=

# Key for the derived drop-off/pickup codes: at least 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
HANDOFF_SECRET=

# Browser origins allowed to call the API (comma separated) and the public app origin.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176
APP_ORIGIN=http://localhost:5173

# Express "trust proxy" (false, true, a hop count or a subnet); set it behind a reverse proxy.
TRUST_PROXY=false
