flowchart TB
    T([":Traveler"])
    W["W :WebApp"]
    API["API :BookingService"]
    IdP["IdP :AppwriteAuth"]
    LDB[("D2 :ListingStore")]
    BDB[("D3 :BookingStore")]
    Pay["Pay :PaymentGateway<br/>(planned, UPI coming soon)"]
    P([":StoragePartner"])

    T -- "1: searchStorage(location)" --> W
    W -- "1.1: getListings(city)" --> API
    API -- "1.1.1: queryAvailable()" --> LDB
    LDB -. "1.1.2: listings" .-> API
    API -. "1.2: availableOptions" .-> W
    W -. "1.3: displayOptions()" .-> T

    T -- "2: login(email, password)" --> W
    W -- "2.1: createSession() → JWT" --> IdP
    W -- "2.2: getMe(JWT)" --> API
    API -- "2.3: verifyJwt()" --> IdP

    T -- "3: confirmBooking(listingId, slot, cash)" --> W
    W -- "3.1: createBooking(details)" --> API
    API -- "3.2: lockListing(), checkCapacity()" --> LDB
    API -- "3.3: saveBookingRecord(Booked)" --> BDB
    API -- "3.4: updateAvailability()" --> LDB
    API -- "3.5: notifyPartner(bookingId)" --> P
    API -. "3.6: bookingConfirmation(qrCode)" .-> W
    W -. "3.7: showConfirmation()" .-> T
    API -. "planned: chargePayment(amount)" .-> Pay
