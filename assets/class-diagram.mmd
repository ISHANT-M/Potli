%%{init: {'themeVariables': {'edgeLabelBackground': '#E8E8E8'}, 'themeCSS': '.edgeLabel .label rect{fill:#E8E8E8 !important;} .edgeLabel .label span{background:#E8E8E8 !important;} .labelBkg{background:#E8E8E8 !important;}'}}%%
classDiagram
    direction TB

    class User {
        <<abstract>>
        +UUID id
        +string appwriteUserId
        +string email
        +string fullName
        +string phone
        +Role role
        +bool isDisabled
        +datetime createdAt
        +toPublicProfile() PublicUser
    }
    note for User "Credentials and sessions are held by Appwrite,<br/>not stored as a password hash."

    class Traveler {
        +searchListings(city, filters) StorageListing[]
        +createBooking(listingId, slot, bags) Booking
        +presentHandoffCode(bookingId, type) Code
        +rateBooking(bookingId, score, comment) Rating
    }

    class StoragePartner {
        +registerBusinessProfile(details) PartnerProfile
        +manageListing(details) StorageListing
        +checkIn(code) Booking
        +confirmDropOff(photos) HandoffRecord
        +confirmPickup(code, cashCollected) Booking
        +viewEarnings() EarningsSummary
    }

    class Administrator {
        +reviewPartner(partnerId, decision) void
        +monitorBookings() Booking[]
        +cancelBooking(bookingId, reason) void
        +resolveDispute(disputeId, resolution) void
        +recordFeeSettlement(partnerId, amount) FeeSettlement
        +disableUser(userId, reason) void
    }

    class PartnerProfile {
        +UUID userId
        +string businessName
        +string businessType
        +string phone
        +string address
        +string city
        +PartnerStatus status
        +string rejectionReason
        +datetime reviewedAt
    }

    class StorageListing {
        +UUID id
        +UUID partnerId
        +string name
        +string address
        +string city
        +double latitude
        +double longitude
        +int capacity
        +int hourlyRatePaise
        +int dailyCapPaise
        +time openTime
        +time closeTime
        +int[] openDays
        +ListingStatus status
        +computePrice(bags, start, end) int
    }

    class Booking {
        +UUID id
        +string code
        +UUID travelerId
        +UUID listingId
        +int bagCount
        +datetime slotStart
        +datetime slotEnd
        +BookingStatus status
        +int quotedPaise
        +int finalPaise
        +PaymentMethod paymentMethod
        +int otpFailedAttempts
        +datetime otpLockedUntil
        +transitionTo(status) void
    }

    class HandoffRecord {
        +UUID id
        +UUID bookingId
        +HandoffType type
        +HandoffMethod method
        +UUID verifiedBy
        +int bagCount
        +string[] photoFileIds
        +datetime verifiedAt
    }

    class Payment {
        +UUID id
        +UUID bookingId
        +PaymentMethod method
        +PaymentStatus status
        +int amountPaise
        +int platformFeePaise
        +int partnerSharePaise
        +datetime collectedAt
        +UUID settlementId
    }

    class FeeSettlement {
        +UUID id
        +UUID partnerId
        +int amountPaise
        +int paymentCount
        +string reference
        +UUID recordedBy
    }

    class Dispute {
        +UUID id
        +UUID bookingId
        +UUID raisedBy
        +string reason
        +DisputeStatus status
        +string resolution
    }

    class AuditLog {
        +UUID id
        +UUID actorId
        +string action
        +string entity
        +string entityId
        +datetime createdAt
    }

    class Rating {
        +UUID id
        +UUID bookingId
        +UUID travelerId
        +UUID listingId
        +int score
        +string comment
    }

    class Role {
        <<enumeration>>
        TRAVELER
        STORAGE_PARTNER
        ADMIN
    }

    class BookingStatus {
        <<enumeration>>
        PENDING_PAYMENT
        BOOKED
        DROPPED
        STORED
        PICKED_UP
        COMPLETED
        CANCELLED
        EXPIRED
    }

    class PartnerStatus {
        <<enumeration>>
        PENDING
        APPROVED
        REJECTED
        SUSPENDED
    }

    class ListingStatus {
        <<enumeration>>
        ACTIVE
        PAUSED
        FLAGGED
    }

    class PaymentMethod {
        <<enumeration>>
        COD
        UPI
        CARD
    }

    class HandoffMethod {
        <<enumeration>>
        QR
        OTP
    }

    class DisputeStatus {
        <<enumeration>>
        OPEN
        RESOLVED
        REJECTED
    }

    class HandoffType {
        <<enumeration>>
        DROP_OFF
        PICKUP
    }

    class PaymentStatus {
        <<enumeration>>
        PENDING
        CAPTURED
        REFUNDED
        PAYOUT_SETTLED
        FAILED
    }

    User <|-- Traveler
    User <|-- StoragePartner
    User <|-- Administrator
    User "1" *-- "1" Role

    StoragePartner "1" *-- "1" PartnerProfile : has
    StoragePartner "1" o-- "0..*" StorageListing : manages
    Administrator "1" ..> "0..*" StoragePartner : approves
    Administrator "1" ..> "0..*" StorageListing : flags
    Administrator "1" ..> "0..*" Booking : audits

    Traveler "1" --> "0..*" Booking : makes
    StorageListing "1" --> "0..*" Booking : receives
    Booking "1" *-- "1" BookingStatus
    Booking "1" *-- "0..2" HandoffRecord : logs
    HandoffRecord "1" *-- "1" HandoffType
    Booking "1" *-- "0..1" Payment : settled by
    Payment "1" *-- "1" PaymentStatus
    Booking "1" o-- "0..1" Rating : rated by
    PartnerProfile "1" *-- "1" PartnerStatus
    StorageListing "1" *-- "1" ListingStatus
    Booking "1" *-- "1" PaymentMethod
    Payment "1" *-- "1" PaymentMethod
    HandoffRecord "1" *-- "1" HandoffMethod
    Booking "1" o-- "0..*" Dispute : disputed by
    Dispute "1" *-- "1" DisputeStatus
    FeeSettlement "0..1" o-- "0..*" Payment : settles
    StoragePartner "1" --> "0..*" FeeSettlement : owes via
    Administrator "1" ..> "0..*" AuditLog : reviews
