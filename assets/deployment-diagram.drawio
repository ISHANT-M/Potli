<mxfile host="app.diagrams.net">
  <diagram id="potli-deployment" name="Deployment Diagram">
    <mxGraphModel grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1700" pageHeight="660" background="#ffffff">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="POTLI Deployment Diagram&#xa;Proposed user-facing topology · Potli frontend and API host not yet deployed" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontColor=#222222;fontSize=23;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="350" y="15" width="1000" height="75" as="geometry"/></mxCell>
        <mxCell id="user" value="«device» User device&#xa;&#xa;Phone or laptop&#xa;Browser: Potli web app" style="shape=cube;size=20;direction=south;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingTop=25;spacingLeft=20;fontFamily=Arial;fontSize=19;strokeColor=#444444;strokeWidth=2;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="245" width="310" height="310" as="geometry"/></mxCell>
        <mxCell id="internet" value="Internet" style="shape=cloud;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=21;fontStyle=1;strokeColor=#444444;strokeWidth=2;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="463" y="405" width="190" height="110" as="geometry"/></mxCell>
        <mxCell id="app" value="«device» Potli app host (proposed)&#xa;&#xa;Static frontend assets&#xa;Node.js / Express API&#xa;Drizzle database client" style="shape=cube;size=20;direction=south;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingTop=25;spacingLeft=20;fontFamily=Arial;fontSize=19;strokeColor=#444444;strokeWidth=2;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="810" y="245" width="330" height="310" as="geometry"/></mxCell>
        <mxCell id="host" value="«device» Shared homelab host&#xa;&#xa;Appwrite: login, sessions, photos&#xa;Catcher: checks infra JWT, relays SQL&#xa;PostgreSQL: appwrite DB (internals)&#xa;potli DB (profiles, bookings)" style="shape=cube;size=20;direction=south;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingTop=25;spacingLeft=20;fontFamily=Arial;fontSize=19;strokeColor=#444444;strokeWidth=2;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1270" y="245" width="390" height="310" as="geometry"/></mxCell>
        <mxCell id="user-internet" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;strokeColor=#444444;strokeWidth=2;fontFamily=Arial;fontSize=16;exitX=1;exitY=0.77;entryX=0;entryY=0.72;" edge="1" parent="1" source="user" target="internet"><mxGeometry relative="1" as="geometry"/></mxCell>
