        <mxCell id="app-host" value="HTTPS / WSS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;strokeColor=#444444;strokeWidth=2;fontFamily=Arial;fontSize=16;exitX=1;exitY=0.77;entryX=0;entryY=0.77;" edge="1" parent="1" source="app" target="host"><mxGeometry relative="1" as="geometry"/></mxCell>
